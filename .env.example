SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# One Apify account per source
APIFY_TOKEN_NAUKRI=
APIFY_TOKEN_LINKEDIN=

# Monthly budget per source in USD (optional, default 5 each)
APIFY_MONTHLY_LIMIT_NAUKRI_USD=5
APIFY_MONTHLY_LIMIT_LINKEDIN_USD=5

# Optional Actor overrides
APIFY_NAUKRI_ACTOR_ID=
APIFY_LINKEDIN_ACTOR_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

GMAIL_FROM=
GMAIL_TO=
# Optional: comma-separated, e.g. a@company.com,b@company.com
GMAIL_CC=
GMAIL_BCC=

HIREINTEL_MAX_KEYWORDS=1
HIREINTEL_MAX_JOBS_PER_KEYWORD=1
HIREINTEL_DRY_RUN=false
HIREINTEL_INCLUDE_DESCRIPTION=true
HIREINTEL_SAVE_TO_DATABASE=true
HIREINTEL_SEND_EMAIL_REPORT=true
HIREINTEL_TIMEOUT_SECS=300
HIREINTEL_MAX_TOTAL_CHARGE_USD=0.50

# Only keep jobs posted within the last N days (default 7)
HIREINTEL_MAX_POSTED_AGE_DAYS=7
# Keep jobs whose posting date is missing (default false = drop them)
HIREINTEL_KEEP_UNDATED_JOBS=false
# Optional: override the LinkedIn actor's datePosted value ("1", "7", "30")
HIREINTEL_LINKEDIN_DATE_POSTED=
